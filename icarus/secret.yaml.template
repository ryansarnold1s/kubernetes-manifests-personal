# Copy to secret.yaml, set real passwords, then apply.
# secret.yaml is gitignored by the repo-root **/secret.yaml rule -- never commit it.
#
#   server-password -> SERVER_PASSWORD       -> JoinPassword=
#   admin-password  -> SERVER_ADMIN_PASSWORD -> AdminPassword=
#
# ⚠️ Both passwords are written IN PLAINTEXT to ServerSettings.ini on the icarus-data
# PVC. They are therefore present in every Longhorn snapshot and every CloudCasa backup.
# Treat any snapshot of icarus-data as containing them.
#
# ⚠️ Blanking a password here does NOT clear it from the .ini. icarus-bootstrap guards
# each `sed` with a non-empty test, so an empty value is indistinguishable from an unset
# one and the OLD password simply stays in the file and stays live. Clearing a password
# means editing ServerSettings.ini on the PVC directly -- see README.md.
#
# ⚠️ Keep both values ALPHANUMERIC. They are substituted into the .ini with `sed`, so a
# `/` breaks the expression, an `&` is replaced by the whole match, and a backslash
# escapes the next character. Any of those silently corrupts the file rather than erroring.
#
# ⚠️ Do NOT set admin-password equal to server-password. AdminPassword grants admin
# rights, so reusing the join password gives every player who can connect the ability to
# administer the server -- including deleting prospects, which
# SERVER_ALLOW_NON_ADMINS_DELETE=False exists specifically to prevent.
apiVersion: v1
kind: Secret
metadata:
  name: icarus-secrets
  namespace: icarus
  labels:
    app: icarus
type: Opaque
stringData:
  server-password: "CHANGEME-join-password"
  admin-password: "CHANGEME-admin-password-long-and-distinct"
